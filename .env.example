# Supabase lokal (Fase 2). Salin file ini menjadi `.env` lalu isi nilainya.
# Nilai default mengikuti `npx supabase start` / `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#Opsional: fallback untuk proyek yang masih memakai anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
