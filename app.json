{
  "expo": {
    "name": "Udin's",
    "slug": "my-finance-mobile",
    "scheme": "myfinance",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/investment.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.myfinance.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/investment.png",
        "monochromeImage": "./assets/investment.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "528f32c1-f116-4094-b3b6-05466828e7f1"
      }
    },
    "owner": "makmalluddin"
  }
}
